---
import GalleryItem from "../../components/GalleryItem.astro";
import enRes from "../../strings/en";
import * as gallery from "../../db/gallery-items";
import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLocale } from "../../locale";

export const prerender = false;
const { id: _id } = Astro.params;
const id = _id ? Number.parseInt(_id) : undefined;
if (!Number.isInteger(id)) {
  return Astro.redirect("/404");
}
const photo = await gallery.query(id!);
if (typeof photo === "undefined" || photo.trashed) {
  return Astro.redirect("/404");
}
const photoLocale = photo.locale ?? defaultLocale;
if (photoLocale && photoLocale !== enRes.localeName) {
  return Astro.redirect(
    getRelativeLocaleUrl(photoLocale ?? defaultLocale, `/gallery/${id}`),
  );
}
---

<GalleryItem
  i18n={enRes}
  src={photo.image}
  alt={photo.alt}
  id={id!}
  tweet={photo.tweet}
  created={photo.created}
/>
