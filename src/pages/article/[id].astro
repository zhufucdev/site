---
import FrontmatterDefault from "../../layouts/FrontmatterDefault.astro";
import i18n from "../../strings/en.ts";
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { getRelativeArticleUrl } from "../../utils/article-url";
import getEmbeddedComponents from "../../utils/embedded-components";
export const getStaticPaths = (async () => {
  const posts = await getCollection("articles-en");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const embeddedComponents = getEmbeddedComponents();
---

<FrontmatterDefault
  i18n={i18n}
  url={getRelativeArticleUrl(post.id, "en")}
  frontmatter={post.data}
>
  <Content components={embeddedComponents} />
</FrontmatterDefault>
