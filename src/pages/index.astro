---
import Master from "../layouts/Master.astro";
import Topbar from "../components/Topbar.astro";
import CoveredPostCard from "../components/CoveredPostCard.astro";
import ArrowHighlightingButton from "../components/ArrowHighlightingButton.astro";
import TitleSummary from "../components/TitleSummary.astro";
import BlueprintSheet from "../components/BlueprintSheet.astro";
import i18n from "../strings/en";
---

<Master title={i18n.highlights_para} lang="en">
  <Topbar slot="nav" i18n={i18n} currentItem="" />
  <div class="flex flex-row flex-wrap gap-4 px-2 sm:px-6">
    <CoveredPostCard
      cover="url(/quick-brown-fox-jumping-over-a-dog.jpg)"
      mask="url(/ElevenSidedStar.svg)"
      class="flex-1"
    >
      <Fragment slot="header-leading" set:text="Status update" />
      <Fragment slot="header-tailing" set:text="28th Dec." />
      <Fragment
        slot="title"
        set:text="Did the quick brown fox really jump over the lazy dog?"
      />
      <Fragment
        slot="summary"
        set:text="I did say, but can I really eat glass? Should have known before it's too late."
      />
    </CoveredPostCard>

    <CoveredPostCard
      cover="url(/ferris-with-knief.png)"
      mask="url(/TiltedRectangle.svg)"
      class="flex-1"
    >
      <Fragment slot="header-leading" set:text="News" />
      <Fragment slot="header-tailing" set:text="22th Dec." />
      <Fragment slot="title" set:text="Binder CVE" />
      <Fragment
        slot="summary"
        set:text="There was a piece of Rust code in the Linux kernel that led to a potential race condition."
      />
    </CoveredPostCard>
  </div>

  <div
    class="mt-2 h-20 w-full bg-gray-100 mask-[url(/WaveSegment.svg)] bg-repeat-x"
  >
  </div>
  <div
    class="flex flex-row flex-wrap gap-4 border-b-3 border-b-gray-500 bg-linear-to-b from-gray-100 via-gray-200 via-70% to-gray-300 px-2 pb-8 sm:px-6"
  >
    <BlueprintSheet class="flex-2">
      <TitleSummary>
        <Fragment slot="title" set:text="Liquid Glass Toolbar Flickering" />
        <Fragment
          slot="summary"
          set:text="It's high time for me to adapt the new design language for Apple platforms. However, my app uses an asynchronize data loading model, which is not how Apple does things."
        />
      </TitleSummary>
      <ArrowHighlightingButton slot="bottom" href="#"
        >{i18n.read_full_para}</ArrowHighlightingButton
      >
    </BlueprintSheet>

    <BlueprintSheet class="flex-1">
      <TitleSummary>
        <Fragment slot="title" set:text="As an AWS Engineer" />
        <Fragment
          slot="summary"
          set:text="I have been working for Amazon since 3 years ago, and I am 22. What a shocker."
        />
      </TitleSummary>
      <ArrowHighlightingButton slot="bottom" href="#"
        >{i18n.read_full_para}</ArrowHighlightingButton
      >
    </BlueprintSheet>
  </div>

  <div class="h-12"></div>
</Master>
