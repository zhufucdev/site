---
import Master from "../layouts/Master.astro";
import Topbar from "../components/Topbar.astro";
import CoveredPostCard from "../components/CoveredPostCard.astro";
import ArrowHighlightingButton from "../components/ArrowHighlightingButton.astro";
import TitleSummary from "../components/TitleSummary.astro";
import BlueprintSheet from "../components/BlueprintSheet.astro";
import RssSection from "../components/RssSection.tsx";
import SourceSection from "../components/SourceSection.tsx";
import TracePhotoCamera from "../icons/TracePhotoCamera.svg";
import BottomFooter from "../components/BottomFooter.astro";
import i18n from "../strings/en";
import { createHighlighter } from "shiki";
const highlighter = await createHighlighter({
  themes: ["one-light"],
  langs: ["xml"],
});
---

<Master title={i18n.highlights_para} lang="en">
  <Topbar slot="nav" i18n={i18n} currentItem="" />
  <BottomFooter slot="footer" i18n={i18n} currentNavItem="/" />
  <div class="flex flex-row flex-wrap gap-4 px-2 sm:px-6">
    <CoveredPostCard
      cover="url(/quick-brown-fox-jumping-over-a-dog.jpg)"
      mask="url(/ElevenSidedStar.svg)"
      class="flex-1"
    >
      <Fragment slot="header-leading" set:text="Status update" />
      <Fragment slot="header-tailing" set:text="28th Dec." />
      <Fragment
        slot="title"
        set:text="Did the quick brown fox really jump over the lazy dog?"
      />
      <Fragment
        slot="summary"
        set:text="I did say, but can I really eat glass? Should have known before it's too late."
      />
    </CoveredPostCard>

    <CoveredPostCard
      cover="url(/ferris-with-knief.png)"
      mask="url(/TiltedRectangle.svg)"
      class="flex-1"
    >
      <Fragment slot="header-leading" set:text="News" />
      <Fragment slot="header-tailing" set:text="22th Dec." />
      <Fragment slot="title" set:text="Binder CVE" />
      <Fragment
        slot="summary"
        set:text="There was a piece of Rust code in the Linux kernel that led to a potential race condition."
      />
    </CoveredPostCard>
  </div>

  <div
    class="mt-2 h-20 w-full bg-gray-100 mask-[url(/WaveSegment.svg)] bg-repeat-x"
  >
  </div>
  <div
    class="flex flex-row flex-wrap gap-4 border-b-3 border-b-gray-100 bg-linear-to-b from-gray-100 via-gray-200 via-70% to-gray-300 px-2 pb-8 sm:px-6"
  >
    <BlueprintSheet class="flex-2">
      <TitleSummary>
        <Fragment slot="title" set:text="Liquid Glass Toolbar Flickering" />
        <Fragment
          slot="summary"
          set:text="It's high time for me to adapt the new design language for Apple platforms. However, my app uses an asynchronize data loading model, which is not how Apple does things."
        />
      </TitleSummary>
      <ArrowHighlightingButton slot="bottom" href="#"
        >{i18n.read_full_para}</ArrowHighlightingButton
      >
    </BlueprintSheet>

    <BlueprintSheet class="flex-1">
      <TitleSummary>
        <Fragment slot="title" set:text="As an AWS Engineer" />
        <Fragment
          slot="summary"
          set:text="I have been working for Amazon since 3 years ago, and I am 22. What a shocker."
        />
      </TitleSummary>
      <ArrowHighlightingButton slot="bottom" href="#"
        >{i18n.read_full_para}</ArrowHighlightingButton
      >
    </BlueprintSheet>
  </div>
  <div class="relative flex overflow-clip max-sm:flex-col sm:flex-row">
    <RssSection class="flex-1 p-6" i18n={i18n} client:idle />
    <SourceSection
      class="flex-1 p-6"
      source="https://github.com/zhufucdev/site.git"
      license="https://www.apache.org/licenses/LICENSE-2.0.txt"
      i18n={i18n}
      client:idle
    />
    <div
      class="absolute right-1/2 -z-10 translate-x-1/2 mask-b-from-0 mask-l-from-0 text-sm max-sm:bottom-0 sm:top-1/2 sm:-translate-y-1/2"
    >
      <Fragment
        set:html={highlighter.codeToHtml(
          `<channel>
  <title>Example dot Come</title>
  <link>http://www.example.com</link>
  <description>Example domain that is free to quote</description>
  <item>
    <title>Sample title</title>
    <link>http://www.example.com/sample</link>
    <description>New Sample is Coming</description>
  </item>
  <item>
    <title>Vaperware</title>
    <link>http://www.example.com/vaperware</link>
    <description>Just a Vaperware</description>
  </item>
</channel>`,
          { lang: "xml", theme: "one-light" },
        )}
      />
    </div>
  </div>
  <div class="relative pt-12 px-2 sm:px-6">
    <TracePhotoCamera class="absolute -top-10 right-0 max-w-60 text-gray-200" />
    <div
      class="flex flex-row flex-wrap items-start gap-2 overflow-clip rounded-2xl"
    >
      {
        Array.from({ length: 10 }).map((_, i) => (
          <img
            src={`https://placecats.com/${["neo", "millie", "millie_neo", "neo_2", "neo_banana"][i % 5]}/300/200`}
            class="min-h-40 min-w-40 flex-1 bg-orange-100 object-cover sm:min-w-[30%] md:max-w-[33%] md:min-w-[20%]"
          />
        ))
      }
    </div>
  </div>
  <div class="h-12"></div>
</Master>
