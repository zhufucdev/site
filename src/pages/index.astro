---
import type { I18nResource } from "../strings/types";
import type Post from "../post";
import Master from "../layouts/Master.astro";
import Topbar from "../components/Topbar.astro";
import CoveredPostCard from "../components/CoveredPostCard.astro";
import ArrowHighlightingButton from "../components/ArrowHighlightingButton.astro";
import TitleSummary from "../components/TitleSummary.astro";
import BlueprintSheet from "../components/BlueprintSheet.astro";
import RssSection from "../components/RssSection.tsx";
import SourceSection from "../components/SourceSection.astro";
import TracePhotoCamera from "../icons/TracePhotoCamera.svg";
import BottomFooter from "../components/BottomFooter.astro";
import enRes from "../strings/en";
import { createHighlighter } from "shiki";
import formatDate from "../utils/dateformat";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { getRelativeArticleUrl } from "../utils/article-url";
import { getRssResponse } from "../utils/rss-template";
import xmlFormat from "xml-formatter";

import waveSegment from "../images/WaveSegment.svg";
import stormcrew from "../images/storm-crew-clothing-wrapper.jpeg";
import ferriesWithKnief from "../images/ferris-with-knief.png";
import elevenSidedStar from "../images/ElevenSidedStar.svg";
import tiltedRectangle from "../images/TiltedRectangle.svg";

const highlighter = await createHighlighter({
  themes: ["one-light", "vitesse-black"],
  langs: ["xml"],
});
interface Props {
  i18n?: I18nResource;
  posts: Partial<Post>[];
  articles?: { id: string; data: any }[];
}
const defaultPosts = [
  {
    created: 1768001767000,
    header: "Status update",
    mask: elevenSidedStar,
    cover: { image: stormcrew, alt: "StormCrew clothing wrapper" },
    title: "Bought some StormCrew clothes",
    summary:
      "It's become a trend or something. My boss and coworkers wore this last dinner party. We don't work for Tim, mind you.",
  },
  {
    created: 1766532967000,
    header: "News",
    mask: tiltedRectangle,
    cover: { image: ferriesWithKnief, alt: "Ferris with knief" },
    title: "Binder CVE",
    summary:
      "There was a piece of Rust code in the Linux kernel that led to a potential race condition.",
  },
];
const {
  i18n = enRes,
  posts: postsProps,
  articles = (await getCollection(`articles-${i18n.localeName}`))
    .sort((a, b) => b.data.created - a.data.created)
    .slice(0, 2),
} = Astro.props;
const posts =
  postsProps?.map((postOverride, index) => ({
    ...defaultPosts[index],
    ...postOverride,
  })) ?? defaultPosts;
---

<Master title={i18n.highlights_para} lang="en">
  <Topbar slot="nav" i18n={i18n} currentItem="" />
  <BottomFooter slot="footer" i18n={i18n} currentNavItem="/" />
  <div class="flex flex-row flex-wrap gap-4 px-2 sm:px-6">
    {
      (
        await Promise.all(
          posts.map(async ({ mask, ...others }) => ({
            ...others,
            mask: `url(${(await getImage({ src: mask })).src})`,
          })),
        )
      ).map(({ created, cover, mask, header, title, summary }) => (
        <CoveredPostCard
          cover={cover && [cover.image, cover.alt]}
          mask={mask}
          class="flex-1"
        >
          <Fragment slot="header-leading" set:text={header} />
          <Fragment
            slot="header-tailing"
            set:text={formatDate(created, i18n.localeName, "short")}
          />
          <Fragment slot="title" set:text={title} />
          <Fragment slot="summary" set:text={summary} />
        </CoveredPostCard>
      ))
    }
  </div>

  <div
    class="mt-2 h-20 w-full bg-gray-100 bg-repeat-x dark:bg-zinc-800"
    style={`mask-image: url(${(await getImage({ src: waveSegment })).src})`}
  >
  </div>
  <div
    class="flex flex-row flex-wrap gap-4 border-b-3 border-b-gray-100 bg-linear-to-b from-gray-100 via-gray-200 to-gray-300 px-2 pb-8 not-dark:via-70% sm:px-6 dark:border-b-zinc-800 dark:from-zinc-800 dark:via-zinc-900 dark:via-30% dark:to-zinc-950"
  >
    {
      articles.map(({ id, data }) => (
        <BlueprintSheet
          style={`flex: ${data.summary.length + data.title.length * 3.3}`}
        >
          <TitleSummary>
            <Fragment slot="title" set:text={data.title} />
            <Fragment slot="summary" set:text={data.summary} />
          </TitleSummary>
          <ArrowHighlightingButton
            slot="bottom"
            href={getRelativeArticleUrl(id, i18n.localeName)}
          >
            {i18n.read_full_para}
          </ArrowHighlightingButton>
        </BlueprintSheet>
      ))
    }
  </div>
  <div class="relative flex overflow-clip max-sm:flex-col sm:flex-row">
    <RssSection class="flex-1 p-6" i18n={i18n} client:idle />
    <SourceSection
      class="flex-1 p-6"
      source="https://github.com/zhufucdev/site.git"
      license="https://www.apache.org/licenses/LICENSE-2.0.txt"
      i18n={i18n}
    />
    <div
      class="absolute -z-10 size-full overflow-clip mask-b-from-0 mask-l-from-0 text-sm"
    >
      <div
        class="absolute top-0 right-1/2 left-0 translate-x-1/2 max-sm:bottom-0 sm:top-1/2 sm:-translate-y-1/2"
      >
        <Fragment
          set:html={highlighter.codeToHtml(
            xmlFormat(
              await (await getRssResponse(i18n, Astro.site!.toString())).text(),
            ),
            {
              lang: "xml",
              themes: { light: "one-light", dark: "vitesse-black" },
            },
          )}
        />
      </div>
    </div>
  </div>
  <div class="relative px-2 pt-12 sm:px-6">
    <TracePhotoCamera
      class="absolute -top-10 right-0 max-w-60 text-gray-200 dark:text-zinc-800"
    />
    <div
      class="flex flex-row flex-wrap items-start gap-2 overflow-clip rounded-2xl"
    >
      {
        Array.from({ length: 10 }).map((_, i) => (
          <img
            src={`https://placecats.com/${["neo", "millie", "millie_neo", "neo_2", "neo_banana"][i % 5]}/300/200`}
            class="min-h-40 min-w-40 flex-1 bg-orange-100 object-cover sm:min-w-[30%] md:max-w-[33%] md:min-w-[20%]"
          />
        ))
      }
    </div>
  </div>
  <div class="h-12"></div>
</Master>
