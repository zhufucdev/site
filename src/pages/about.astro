---
import Master from "../layouts/Master.astro";
import Topbar from "../components/Topbar.astro";
import BottomFooter from "../components/BottomFooter.astro";
import CoveredPostCard from "../components/CoveredPostCard.astro";
import i18n from "../strings/en.ts";

const content = [
  [
    "",
    "SixSidedStar.svg",
    "What are you?",
    "Random person hanging out on the internet, probably nonbinary.",
  ],
  [
    "",
    "TiltedOval.svg",
    "Why is it Jesus on your profile?",
    "TLDR; It's funny. Long story short, one of my friend was suspected. To avoid getting involved, it's better to change my profile, and Jesus is the perfectly moral human (or god) who would never do any harm, so here you are.",
  ],
  [
    "",
    "TiltedPentagon.svg",
    "Are you religious?",
    "<b>No</b>. But I am open to the idea. Try persuading me.",
  ],
  ["", "Clover.svg", "Cats or dogs?", "Cats, definitely."],
  ["", "ElevenSidedStar.svg", "Do you love me?", "I love you all."],
  [
    "",
    "TiltedRectangle.svg",
    "How can I date you?",
    `Whether you are a man, woman or whatever, contact me on <a class="text-orange-500" href="https://t.me/zhufucdev" target="_blank">Telegram</a>.`,
  ],
];
---

<Master title={i18n.about_me_para} lang="en" disableBottomPadding>
  <Topbar slot="nav" i18n={i18n} currentItem="about" />
  <BottomFooter slot="footer" i18n={i18n} currentNavItem="articles" />
  <div
    class="no-scrollbar flex min-h-[calc(100vh-72px)] snap-x snap-mandatory flex-row overflow-x-scroll pb-6"
  >
    {
      content.map(([cover, mask, title, summary], index) => (
        <CoveredPostCard
          cover={cover}
          mask={`url(/${mask})`}
          customColors
          class:list={[
            "ml-6 w-96 snap-center border-gray-100 bg-gray-50 max-sm:w-[calc(100vw-48px)]",
            index == content.length - 1 ? "mr-6" : "",
          ]}
        >
          <Fragment slot="title" set:text={title} />
          <Fragment slot="summary" set:html={summary} />
        </CoveredPostCard>
      ))
    }
  </div>
</Master>
