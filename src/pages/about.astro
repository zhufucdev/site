---
import Master from "../layouts/Master.astro";
import Topbar from "../components/Topbar.astro";
import BottomFooter from "../components/BottomFooter.astro";
import CoveredPostCard from "../components/CoveredPostCard.astro";
import LineExtendedHeader from "../components/LineExtendedHeader.astro";
import type { I18nResource } from "../strings/types";
import { getImage, Image } from "astro:assets";
import type QnaPost from "../qna";
import enRes from "../strings/en.ts";

import sixSidedStar from "/src/images/SixSidedStar.svg";
import tiltedOval from "/src/images/TiltedOval.svg";
import tiltedPentagon from "/src/images/TiltedPentagon.svg";
import clover from "/src/images/Clover.svg";
import elevenSidedStar from "/src/images/ElevenSidedStar.svg";
import tiltedRectangle from "/src/images/TiltedRectangle.svg";
import theTunnelToSummerTheExitOfGoodbyes from "/src/images/the-tunnel-to-summer-the-exit-of-goodbyes.jpg";
import vividStasis from "/src/images/vivid-stasis.png";
import osu from "/src/images/osu.png";
import celeste from "/src/images/celeste.png";
import matrix from "/src/images/matrix.svg";

interface Props {
  i18n?: I18nResource;
  qnaPosts?: Partial<QnaPost>[];
}

const defaultQnaPosts = [
  {
    mask: sixSidedStar,
    question: "Who are you?",
    answer:
      "Random person hanging out on the internet, probably nonbinary. Professional Android developer. Amature 2D designer. Sometimes posts video on YouTube.",
  },
  {
    mask: tiltedOval,
    question: "Why is it Jesus on your profile?",
    answer:
      "TLDR; It's funny. Long story short, one of my friends was suspected. To avoid getting involved, it's better to change my profile, and Jesus is the perfectly moral human (or god) who would never do any harm, so here you are.",
  },
  {
    mask: tiltedPentagon,
    question: "Are you religious?",
    answer: "<b>No</b>. But I am open to the idea. Try persuading me.",
  },
  {
    mask: clover,
    question: "Cats or dogs?",
    answer: "Cats, definitely.",
  },
  {
    mask: elevenSidedStar,
    question: "Do you love me?",
    answer: "I love you all.",
  },
  {
    mask: tiltedRectangle,
    question: "How can I date you?",
    answer: `Whether you are a man, woman or whatever, contact me on my <a class="text-orange-500" href="#socials">socials</a>.`,
  },
];
const { i18n = enRes, qnaPosts: qnaPostsProp } = Astro.props;
const qnaPosts =
  qnaPostsProp?.map((postOverride, index) => ({
    ...defaultQnaPosts[index],
    ...postOverride,
  })) ?? defaultQnaPosts;
---

<Master title={i18n.about_me_para} lang="en">
  <Topbar slot="nav" i18n={i18n} currentItem="about" />
  <BottomFooter slot="footer" i18n={i18n} currentNavItem="/about" />
  <div
    class="no-scrollbar flex min-h-[calc(100vh-190px)] snap-x snap-mandatory flex-row overflow-x-scroll pb-12"
  >
    {
      (
        await Promise.all(
          qnaPosts.map(async ({ mask, ...others }) => ({
            ...others,
            mask: `url(${(await getImage({ src: mask })).src})`,
          })),
        )
      ).map(({ mask, question, answer }, index) => (
        <CoveredPostCard
          mask={mask}
          customColors
          class:list={[
            "ml-6 w-96 snap-center border-gray-100 bg-gray-50 max-sm:w-[calc(100vw-48px)] dark:border-neutral-800 dark:bg-neutral-900",
            index == qnaPosts.length - 1 ? "mr-6" : "",
          ]}
        >
          <Fragment slot="title" set:text={question} />
          <Fragment slot="summary" set:html={answer} />
        </CoveredPostCard>
      ))
    }
  </div>

  <LineExtendedHeader href="reading" class="mb-2"
    >{i18n.reading_para}</LineExtendedHeader
  >
  <div
    class="flex flex-row content-around items-center justify-center gap-4 self-center px-6 pb-12"
  >
    <div class="relative flex-nowrap">
      <Image
        src={theTunnelToSummerTheExitOfGoodbyes}
        class="rounded-sm"
        width="48"
        densities={[1, 2]}
        alt="book cover"
      />
      <div
        class="absolute -right-1 -bottom-1 -z-10 size-full rounded-sm bg-amber-100 dark:bg-stone-800"
      >
      </div>
    </div>
    <div class="flex-1">
      <p class="text-lg">The Tunnel to Summer, the Exit of Goodbyes</p>
      <div class="flex-1"></div>
      <p class="font-sans">Mei Hachimoku</p>
    </div>
  </div>
  <LineExtendedHeader href="playing">{i18n.playing_para}</LineExtendedHeader>
  <div
    class="flex flex-row flex-wrap items-center justify-center py-2 sepia-10"
  >
    <Image
      src={vividStasis}
      width="128"
      alt="vivid/stasis"
      densities={[1, 2]}
    />
    <a href="https://osu.ppy.sh/users/32436131" target="_blank"
      ><Image src={osu} width="48" alt="osu" densities={[1, 2]} /></a
    >
    <Image
      src={celeste}
      width="160"
      class="p-2"
      alt="celeste"
      densities={[1, 2]}
    />
  </div>
  <p class="self-center pb-12 font-sans text-gray-500 dark:text-neutral-500">
    {i18n.asterisk_bad_at_gaming_span}
  </p>

  <LineExtendedHeader href="socials" class="mb-2"
    >{i18n.socials_para}</LineExtendedHeader
  >
  <div class="space-x-4 self-center px-6 text-center sm:py-2">
    <a
      class="ci ci-youtube ci-2x"
      href="https://www.youtube.com/@zhufucdev"
      target="_blank">youtube</a
    >
    <a
      class="ci ci-telegram ci-2x"
      href="https://t.me/zhufucdev"
      target="_blank">telegram</a
    >
    <a
      class="ci ci-discord ci-2x"
      href="https://discordapp.com/users/315265319725826060"
      target="_blank">discord</a
    >
    <a
      class="ci ci-bluesky ci-2x"
      href="https://bsky.app/profile/zhufucdev.bsky.social"
      target="_blank">bluesky</a
    >
    <a
      class="ci ci-x ci-2x dark:bg-white"
      href="https://x.com/zhufucdev"
      target="_blank">twitter / x</a
    >
    <a
      href="https://matrix.to/#/@zhufucdev:matrix.org"
      class="dark:bg-zinc-100"
      style={`content: url(${(await getImage({ src: matrix })).src})`}
      target="_blank">matrix</a
    >
  </div>
  <div class="h-6"></div>
</Master>

<style>
  @import url("https://cdn.jsdelivr.net/gh/dheereshag/coloured-icons@1.9.6/app/ci.min.css");
</style>
