---
import Master from "../layouts/Master.astro";
import Topbar from "../components/Topbar.astro";
import BottomFooter from "../components/BottomFooter.astro";
import CoveredPostCard from "../components/CoveredPostCard.astro";
import LineExtendedHeader from "../components/LineExtendedHeader.astro";
import i18n from "../strings/en.ts";

const content = [
  [
    "",
    "SixSidedStar.svg",
    "Who are you?",
    "Random person hanging out on the internet, probably nonbinary. Professional Android developer at Tencent working on WeChat Work.",
  ],
  [
    "",
    "TiltedOval.svg",
    "Why is it Jesus on your profile?",
    "TLDR; It's funny. Long story short, one of my friends was suspected. To avoid getting involved, it's better to change my profile, and Jesus is the perfectly moral human (or god) who would never do any harm, so here you are.",
  ],
  [
    "",
    "TiltedPentagon.svg",
    "Are you religious?",
    "<b>No</b>. But I am open to the idea. Try persuading me.",
  ],
  ["", "Clover.svg", "Cats or dogs?", "Cats, definitely."],
  ["", "ElevenSidedStar.svg", "Do you love me?", "I love you all."],
  [
    "",
    "TiltedRectangle.svg",
    "How can I date you?",
    `Whether you are a man, woman or whatever, contact me on my <a class="text-orange-500" href="#socials">socials</a>.`,
  ],
];
---

<Master title={i18n.about_me_para} lang="en">
  <Topbar slot="nav" i18n={i18n} currentItem="about" />
  <BottomFooter slot="footer" i18n={i18n} currentNavItem="/about" />
  <div
    class="no-scrollbar flex min-h-[calc(100vh-72px)] snap-x snap-mandatory flex-row overflow-x-scroll pb-12"
  >
    {
      content.map(([cover, mask, title, summary], index) => (
        <CoveredPostCard
          cover={cover}
          mask={`url(/${mask})`}
          customColors
          class:list={[
            "ml-6 w-96 snap-center border-gray-100 bg-gray-50 max-sm:w-[calc(100vw-48px)]",
            index == content.length - 1 ? "mr-6" : "",
          ]}
        >
          <Fragment slot="title" set:text={title} />
          <Fragment slot="summary" set:html={summary} />
        </CoveredPostCard>
      ))
    }
  </div>

  <LineExtendedHeader href="reading" class="mb-2">Reading</LineExtendedHeader>
  <div
    class="flex flex-row content-around items-center justify-center gap-4 self-center px-6 pb-12"
  >
    <div class="relative flex-nowrap">
      <img
        src="/the-tunnel-to-summer-the-exit-of-goodbyes.jpg"
        class="h-12 rounded-sm sm:h-18"
        alt="book cover"
      />
      <div class="absolute -right-1 -bottom-1 -z-10 size-full bg-amber-100 rounded-sm">
      </div>
    </div>
    <div class="flex-1">
      <p class="text-lg">The Tunnel to Summer, the Exit of Goodbyes</p>
      <div class="flex-1"></div>
      <p class="font-sans">Mei Hachimoku</p>
    </div>
  </div>
  <LineExtendedHeader href="playing">Playing</LineExtendedHeader>
  <div
    class="flex flex-row flex-wrap items-center justify-center py-2 sepia-10"
  >
    <img src="/vivid-stasis.png" class="w-28 sm:w-32" alt="vivid/stasis" />
    <a href="https://osu.ppy.sh/users/32436131" target="_blank"
      ><img src="/osu.png" class="h-12 sm:h-18" alt="osu" /></a
    >
    <img src="/celeste.png" class="w-32 p-2 sm:w-40" alt="celeste" />
  </div>
  <p class="self-center pb-12 font-sans text-gray-500">*bad at gaming</p>

  <LineExtendedHeader href="socials" class="mb-2">Socials</LineExtendedHeader>
  <div class="space-x-4 self-center px-6 sm:py-2 text-center">
    <a
      class="ci ci-youtube ci-2x"
      href="https://www.youtube.com/@zhufucdev"
      target="_blank">youtube</a
    >
    <a
      class="ci ci-telegram ci-2x"
      href="https://t.me/zhufucdev"
      target="_blank">telegram</a
    >
    <a
      class="ci ci-discord ci-2x"
      href="https://discordapp.com/users/315265319725826060"
      target="_blank">discord</a
    >
    <a
      class="ci ci-bluesky ci-2x"
      href="https://bsky.app/profile/zhufucdev.bsky.social"
      target="_blank">bluesky</a
    >
    <a class="ci ci-x ci-2x" href="https://x.com/zhufucdev" target="_blank"
      >twitter / x</a
    >
    <a
      href="https://matrix.to/#/@zhufucdev:matrix.org"
      class="content-[url(/matrix.svg)]"
      target="_blank">matrix</a
    >
  </div>
  <div class="h-6"></div>
</Master>

<style>
  @import url("https://cdn.jsdelivr.net/gh/dheereshag/coloured-icons@1.9.6/app/ci.min.css");
</style>
