---
import Master from "../layouts/Master.astro";
import type { I18nResource } from "../strings/types";
import enRes from "../strings/en.ts";
import Topbar from "../components/Topbar.astro";
import TitleSummary from "../components/TitleSummary.astro";
import UnderliningTextButton from "../components/UnderliningTextButton.astro";
import BottomFooter from "../components/BottomFooter.astro";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import type { ArticlesData } from "../article";
interface Props {
  i18n?: I18nResource;
  data?: ArticlesData;
}
const {
  i18n = enRes,
  data = [
    {
      year: 2025,
      articles: [
        {
          title: "Liquid Glass Toolbar Flickering",
          summary:
            "It's high time for me to adapt the new design language for Apple platforms. However, my app uses an asynchronize data loading model, which is not how Apple does things.",
        },
        {
          title: "Terrible Play Store Developer Experience",
          summary:
            "My plan is the flagship app to be released on Google Play store, which has taken well over 3 months, and is not going well. To be fair, I spent far less on marketing than developing. The former however, has taken so much more time than expected.",
          href: "terrible-play-store-developer-experience",
        },
        {
          title: "As an AWS Engineer",
          summary:
            "I have been working for Amazon since 3 years ago, and I am 22. What a shocker.",
        },
        {
          title: "How to Program in Sea",
          summary:
            "Recently, I have been working on a project that requires me to program in sea. I am not sure if I will be able to finish it, but I am eager to learn.",
        },
        {
          title: "Apple Watch as a Service",
          summary:
            "Apple Watch has become an important part of people's life. Running AWaaS to provide a seamless experience for users is a great idea.",
        },
      ],
    },
    {
      year: 2024,
      articles: [
        {
          title: "How to Get Hired",
          summary:
            "I challenge myself to get hired by a company. There're several candidates in my mind.",
        },
      ],
    },
  ],
} = Astro.props;
---

<Master title={i18n.all_articles_para} lang={i18n.localeName}>
  <Topbar slot="nav" i18n={i18n} currentItem="articles" />
  <BottomFooter slot="footer" i18n={i18n} currentNavItem="articles" />
  <div class="flex flex-col gap-6 px-2 sm:px-6">
    {
      data.map(({ year, articles }) => (
        <>
          <h1 class="text-3xl font-semibold" id={String(year)}>
            <a
              href={`#${year}`}
              class="flex flex-row items-center gap-2 transition-all hover:text-orange-600"
            >
              <span class="size-2 rounded-full outline-5 outline-orange-500 max-sm:mx-2 sm:mr-2" />
              {year}
            </a>
          </h1>
          {articles.map(({ title, summary, href }) => (
            <>
              <a
                href={
                  href
                    ? getAbsoluteLocaleUrl(i18n.localeName, `/article/${href}`)
                    : "#"
                }
                class="group"
              >
                <h2 class="flex flex-row wrap-break-word">
                  <UnderliningTextButton slot="title">
                    {title}
                  </UnderliningTextButton>
                </h2>
                <p class="font-sans">{summary}</p>
              </a>
              <hr class="text-gray-300" />
            </>
          ))}
        </>
      ))
    }
  </div>
</Master>
