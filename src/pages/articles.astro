---
import Master from "../layouts/Master.astro";
import type { I18nResource } from "../strings/types";
import enRes from "../strings/en.ts";
import Topbar from "../components/Topbar.astro";
import UnderliningTextButton from "../components/UnderliningTextButton.astro";
import BottomFooter from "../components/BottomFooter.astro";
import getArticleUrl from "../utils/article-url";
import type { ArticlesData } from "../article";
import getArticlesDataFromCollection from "../utils/article-data-from-collection";
import { getCollection } from "astro:content";
interface Props {
  i18n?: I18nResource;
  data?: ArticlesData;
}
const {
  i18n = enRes,
  data = getArticlesDataFromCollection(await getCollection("articles-en")),
} = Astro.props;
---

<Master title={i18n.all_articles_para} lang={i18n.localeName}>
  <Topbar slot="nav" i18n={i18n} currentItem="articles" />
  <BottomFooter slot="footer" i18n={i18n} currentNavItem="articles" />
  <div class="flex flex-col gap-6 px-6">
    {
      data.map(({ year, articles }) => (
        <>
          <h1 class="text-3xl font-semibold" id={String(year)}>
            <a
              href={`#${year}`}
              class="flex flex-row items-center gap-2 transition-all hover:text-orange-600"
            >
              <span class="size-2 rounded-full outline-5 outline-orange-500 max-sm:mx-2 sm:mr-2" />
              {year}
            </a>
          </h1>
          {articles.map(({ title, summary, id }) => (
            <>
              <a
                href={id ? getArticleUrl(id, i18n.localeName) : "#"}
                class="group"
              >
                <h2 class="flex flex-row wrap-break-word">
                  <UnderliningTextButton slot="title">
                    {title}
                  </UnderliningTextButton>
                </h2>
                <p class="font-sans">{summary}</p>
              </a>
              <hr class="text-gray-300" />
            </>
          ))}
        </>
      ))
    }
  </div>
</Master>
