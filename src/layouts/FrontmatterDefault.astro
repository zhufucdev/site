---
import Master from "./Master.astro";
import Topbar from "../components/Topbar.astro";
import BottomFooter from "../components/BottomFooter.astro";
import type { I18nResource } from "../strings/types";
import formatDate from "../utils/dateformat";
interface Props {
  i18n: I18nResource;
  frontmatter: any;
  url: string;
}
const { frontmatter, i18n, url } = Astro.props;
---

<Master
  lang={i18n.localeName}
  title={frontmatter.title}
  description={frontmatter.summary}
  class="px-6 font-sans"
>
  <Topbar
    slot="nav"
    i18n={i18n}
    currentItem="articles"
    allowNavigateToCurrent
  />
  <article class="max-w-2xl space-y-2 self-center">
    <header class="font-default text-4xl">
      {frontmatter.title}
    </header>
    <p class="font-default">
      {formatDate(frontmatter.created, i18n.localeName, "long")}
    </p>
    <slot />
  </article>
  <div class="h-6"></div>
  <BottomFooter slot="footer" i18n={i18n} currentNavItem={url} />
</Master>

<style>
  @import "../styles/global.css";
  article :global(h1) {
    @apply text-3xl;
  }
  article :global(h2) {
    @apply text-2xl;
  }
  article :global(h3) {
    @apply text-xl;
  }
  article :global(h4) {
    @apply text-lg;
  }
  article :global(ul) {
    @apply list-inside list-disc;
  }
  article :global(ol) {
    @apply list-inside list-decimal;
  }
  article :global(a) {
    @apply -mb-1.5 inline-block max-w-[calc(100vw-2rem)] overflow-clip text-ellipsis whitespace-nowrap text-orange-500 transition-colors hover:text-orange-600 focus:underline;
  }
  article :global(blockquote) {
    @apply rounded-e-lg border-l-4 border-l-orange-500 bg-orange-50 px-2 py-1 dark:bg-stone-800;
  }
  article :global(code) {
    @apply bg-gray-100 px-1 dark:bg-neutral-900;
  }
  article :global(pre code) {
    @apply bg-inherit;
  }
  article :global(pre) {
    @apply max-w-[calc(100vw-2rem)] rounded-lg p-2;
  }
  article :global(img) {
    @apply m-auto max-h-96 max-w-full object-contain;
  }
  article :global(table) {
    @apply max-w-[calc(100vw-2rem)] overflow-x-scroll;
  }
  article :global(li p) {
    @apply inline;
  }
  article :global(li li) {
    @apply ml-4;
  }
  article :global(.shiki) {
    overflow-x: scroll;
  }

  article :global(.mermaid-default) {
    @media (prefers-color-scheme: dark) {
      display: none !important;
    }
  }
  article :global(.mermaid-dark) {
    @media (prefers-color-scheme: dark) {
      display: block !important;
    }
  }
  article :global(.mermaid:not([data-processed])) {
    display: none;
  }
  article :global(.mermaid.dark) {
    @media (prefers-color-scheme: light) {
      display: none;
    }
  }
  article :global(.mermaid.light) {
    @media (prefers-color-scheme: dark) {
      display: none;
    }
  }
</style>

<script>
  import mermaid from "mermaid";
  const query = window.matchMedia("(prefers-color-scheme: dark)");

  function runMermaid(darkMode: boolean) {
    mermaid.initialize({
      theme: darkMode ? "dark" : "neutral",
      startOnLoad: false,
    });
    mermaid.run({
      querySelector: `.mermaid.${darkMode ? "dark" : "light"}`,
    });
  }
  query.addEventListener("change", (event) => {
    runMermaid(event.matches);
  });
  document.addEventListener("astro:page-load", () => {
    runMermaid(query.matches);
  });
</script>
