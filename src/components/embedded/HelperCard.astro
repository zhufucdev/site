---
interface Props {
  variant?: "help" | "success" | "warn" | "error";
  title: string;
}
const { variant = "help", title } = Astro.props;
let colors: string;
switch (variant) {
  case "help":
    colors = "bg-gray-300 outline-gray-500";
    break;
  case "success":
    colors = "bg-green-50 outline-gray-200";
    break;
  case "warn":
    colors = "bg-orange-50 outline-gray-400";
    break;
  case "error":
    colors = "bg-red-50 outline-gray-400";
    break;
}
---

<div class:list={[colors, "rounded-lg py-4 px-4 outline-2 space-y-2 -mx-2"]}>
  <p class="text-lg">{title}</p>
  <slot />
</div>
