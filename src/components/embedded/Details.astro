---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<custom-details class="group">
  <p
    class="text-right text-orange-500 group-[.expanded]:hidden hover:text-orange-600"
  >
    <button>{title}</button>
  </p>
  <div
    class="hidden text-gray-500 group-[.expanded]:block dark:text-neutral-500"
  >
    <slot />
  </div>
</custom-details>

<script>
  class Details extends HTMLElement {
    expanded = false;
    connectedCallback() {
      this.expanded = false;
      this.querySelector("button")!.addEventListener("click", () => {
        if (this.expanded) {
          return;
        }
        this.expanded = true;
        this.classList.add("expanded");
      });
    }
  }
  customElements.define("custom-details", Details);
</script>
