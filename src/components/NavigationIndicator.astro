---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<navigation-indicator
  class:list={["fixed z-100 h-1 w-full", className]}
  transition:persist
  style="display: none"
>
  <div id="bar" class="h-full bg-orange-500"></div>
</navigation-indicator>

<script is:inline>
  class NavigationIndicator extends HTMLElement {
    transitioning = false;
    constructor() {
      super();
      this.bar = this.querySelector("#bar");
    }
    beforePreparation = () => {
      this.transitioning = true;
      setTimeout(() => {
        if (this.transitioning) {
          this.bar.style.animation = "10s ease-in-out both progress";
          this.style.display = "inherit";
        }
      }, 300);
    };
    afterPreparation = () => {
      this.transitioning = false;
      this.bar.style.animation = "";
      this.style.display = "none";
    };
    connectedCallback() {
      document.addEventListener(
        "astro:before-preparation",
        this.beforePreparation,
      );
      document.addEventListener(
        "astro:after-preparation",
        this.afterPreparation,
      );
    }
    disconnectedCallback() {
      document.removeEventListener(
        "astro:before-preparation",
        this.beforePreparation,
      );
      document.removeEventListener(
        "astro:after-preparation",
        this.afterPreparation,
      );
    }
  }
  customElements.define("navigation-indicator", NavigationIndicator);
</script>

<style>
  @keyframes progress {
    from {
      width: 0;
    }
    5% {
      width: 30%;
    }
    50% {
      width: 90%;
    }
    to {
      width: 100%;
    }
  }
</style>
