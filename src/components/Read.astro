---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
interface Props {
  cover: ImageMetadata;
  class?: string;
}
const { cover, class: className } = Astro.props;
---

<div
  class:list={[
    "flex flex-row content-around items-center justify-center gap-4 self-center min-w-72",
    className,
  ]}
>
  <div class="relative flex-nowrap">
    <Image
      src={cover}
      class="rounded-sm"
      width="48"
      densities={[1, 2]}
      alt="book cover"
    />
    <div
      class="absolute -right-1 -bottom-1 -z-10 size-full rounded-sm bg-amber-100 dark:bg-stone-800"
    >
    </div>
  </div>
  <div class="flex-1">
    <p class="text-lg"><slot name="title" /></p>
    <div class="flex-1"></div>
    <p class="opacity-65"><slot name="author" /></p>
  </div>
</div>
