---
import { Image } from "astro:assets";
import TitleSummary from "./TitleSummary.astro";
import type { ImageMetadata } from "astro";
interface Props {
  cover?: [ImageMetadata, string];
  mask: string;
  class?: string;
  customColors?: boolean;
  coverAlt?: string;
}
const { cover, mask, class: className, customColors = false } = Astro.props;
---

<div
  class:list={[
    "@container flex min-w-72 flex-col space-y-4 overflow-clip rounded-2xl border-2 p-6",
    customColors ? "" : "border-gray-500 bg-gray-300",
    className,
  ]}
>
  {
    Astro.slots.has("header-leading") && Astro.slots.has("header-tailing") && (
      <p class="space-x-2 font-mono leading-8">
        <span class="bg-orange-600 p-2 text-white"><slot name="header-leading" /></span>
        <span><slot name="header-tailing" /></span>
      </p>
    )
  }
  <div class="relative z-0 min-h-72 flex-1 @max-md:pb-72">
    <div class="space-y-4 @md:mr-72">
      <TitleSummary>
        <slot name="title" slot="title" />
        <slot name="summary" slot="summary" />
      </TitleSummary>
    </div>
    <div
      class="absolute -right-24 -bottom-24 -z-10 h-96 w-96 overflow-clip bg-orange-100 bg-cover"
      style={[mask ? `mask-image: ${mask}` : ""]
        .filter((p) => Boolean(p))
        .join(";")}
    >
      {cover && <Image src={cover[0]} alt={cover[1]} class="size-full object-cover" />}
    </div>
  </div>
</div>
