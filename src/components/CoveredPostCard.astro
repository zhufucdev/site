---
import Unimage from "./Unimage.astro";
import TitleSummary from "./TitleSummary.astro";
import type { ImageMetadata } from "astro";
interface Props {
  cover?: { image: string | ImageMetadata; alt: string };
  mask: string;
  class?: string;
  customColors?: boolean;
}
const { cover, mask, class: className, customColors = false } = Astro.props;
---

<div
  class:list={[
    "@container flex min-w-72 flex-col space-y-4 overflow-clip rounded-2xl border-2 p-6",
    customColors
      ? ""
      : "border-gray-500 bg-gray-300 dark:border-neutral-500 dark:bg-neutral-700",
    className,
  ]}
>
  {
    Astro.slots.has("header-leading") && Astro.slots.has("header-tailing") && (
      <p class="space-x-2 font-mono leading-8">
        <span class="bg-orange-600 p-2 text-white">
          <slot name="header-leading" />
        </span>
        <span>
          <slot name="header-tailing" />
        </span>
      </p>
    )
  }
  <div class="relative z-0 min-h-72 flex-1 @max-md:pb-72">
    <div class="space-y-4 @md:mr-72">
      <TitleSummary>
        <slot name="title" slot="title" />
        <slot name="summary" slot="summary" />
      </TitleSummary>
    </div>
    <div
      class="absolute -right-24 -bottom-24 -z-10 h-96 w-96 overflow-clip bg-orange-100 bg-cover dark:bg-stone-800"
      style={[mask ? `mask-image: ${mask}` : ""]
        .filter((p) => Boolean(p))
        .join(";")}
    >
      {
        cover && (
          <Unimage
            image={cover.image}
            alt={cover.alt}
            width={384}
            height={384}
            class="object-cover aspect-square"
          />
        )
      }
    </div>
  </div>
</div>
