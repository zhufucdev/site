---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { I18nResource } from "../strings/types";
import ArrowUnderliningTextButton from "./ArrowUnderliningTextButton.astro";

const { i18n, currentItem, allowNavigateToCurrent = false } = Astro.props;
const items = [
  ["", i18n.highlights_para],
  ["articles", i18n.all_articles_para],
  ["about", i18n.about_me_para],
] as const;
interface Props {
  i18n: I18nResource;
  currentItem?: (typeof items)[number][0];
  allowNavigateToCurrent?: boolean;
}
---

<site-topbar class="relative">
  {
    typeof currentItem === "string" && (
      <button
        class="flex flex-row p-4 sm:hidden"
        id="topbar-persistent-item"
        transition:animate="none"
      >
        <ArrowUnderliningTextButton selected>
          {items.find(([ref]) => ref == currentItem)![1]}
        </ArrowUnderliningTextButton>
      </button>
    )
  }
  <div
    class="top-0 z-10 flex flex-col items-start gap-4 p-4 max-sm:absolute max-sm:hidden max-sm:h-screen max-sm:w-screen max-sm:bg-white sm:flex-row dark:max-sm:bg-neutral-950"
    id="topbar-expanded-items"
    transition:animate="none"
    transition:name="topbar"
  >
    {
      items.map(([href, name]) => (
        <a
          class="topbar-list-item"
          aria-busy={currentItem == href && !allowNavigateToCurrent}
          href={getRelativeLocaleUrl(i18n.localeName, href)}
        >
          <ArrowUnderliningTextButton selected={href == currentItem}>
            {name}
          </ArrowUnderliningTextButton>
        </a>
      ))
    }
  </div>
</site-topbar>

<script>
  class Topbar extends HTMLElement {
    expandedItemsContainer!: HTMLDivElement;
    persistentItemContainer!: HTMLDivElement;
    aboveSm = false;

    private recompute() {
      const aboveSm =
        this.persistentItemContainer.computedStyleMap().get("display") ==
        "none";
      this.setExpandedItemsContainerVisibility(aboveSm);
      return aboveSm;
    }

    setExpandedItemsContainerVisibility(visble: boolean) {
      this.expandedItemsContainer.style.display = visble ? "flex" : "none";
    }

    private onWindowResize = () => {
      this.aboveSm = this.recompute();
    }

    connectedCallback() {
      this.expandedItemsContainer = this.querySelector(
        "#topbar-expanded-items",
      )!;
      this.persistentItemContainer = this.querySelector(
        "#topbar-persistent-item",
      )!;
      this.aboveSm = this.recompute();
      window.addEventListener("resize", this.onWindowResize);
      this.persistentItemContainer.addEventListener("click", (event) => {
        if (this.aboveSm) {
          event.preventDefault();
          return;
        }
        this.setExpandedItemsContainerVisibility(true);
      });
      this.querySelectorAll(".topbar-list-item").forEach((item) =>
        item.addEventListener("click", (event) => {
          if (item.ariaBusy == "true") {
            event.preventDefault();
          }
          if (!this.aboveSm) {
            this.setExpandedItemsContainerVisibility(false);
          }
        }),
      );
    }

    disconnectedCallback() {
      window.removeEventListener("resize", this.onWindowResize);
    }
  }

  customElements.define("site-topbar", Topbar);
</script>
