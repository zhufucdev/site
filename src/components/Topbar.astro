---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import type { I18nResource } from "../strings/types";
import ArrowUnderliningTextButton from "./ArrowUnderliningTextButton.astro";

const { i18n, currentItem } = Astro.props;
const items = [
  ["", i18n.highlights_para],
  ["articles", i18n.all_articles_para],
  ["about", i18n.about_me_para],
] as const;
interface Props {
  i18n: I18nResource;
  currentItem?: (typeof items)[number][0];
}
---

<div class="relative">
  <div
    class="p-4 sm:hidden"
    id="topbar-persistent-item"
    transition:animate="none"
  >
    <ArrowUnderliningTextButton selected>
      {items.find(([ref]) => ref == currentItem)![1]}
    </ArrowUnderliningTextButton>
  </div>
  <div
    class="top-0 z-10 flex flex-col items-start gap-4 p-4 max-sm:absolute max-sm:hidden max-sm:h-screen max-sm:w-screen max-sm:bg-white sm:flex-row"
    id="topbar-expanded-items"
    transition:animate="none"
    transition:name="topbar"
  >
    {
      items.map(([href, name]) => (
        <a
          class="topbar-list-item"
          href={getAbsoluteLocaleUrl(i18n.localeName, href)}
        >
          <ArrowUnderliningTextButton selected={href == currentItem}>
            {name}
          </ArrowUnderliningTextButton>
        </a>
      ))
    }
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const expandedItemsContainer = document.getElementById(
      "topbar-expanded-items",
    )!;
    const persistentItemContainer = document.getElementById(
      "topbar-persistent-item",
    )!;
    function setExpandedItemsContainerVisibility(visble: boolean) {
      expandedItemsContainer.style.display = visble ? "flex" : "none";
    }
    let aboveSm = recompute();
    function recompute() {
      const aboveSm =
        persistentItemContainer.computedStyleMap().get("display") == "none";
      setExpandedItemsContainerVisibility(aboveSm);
      return aboveSm;
    }
    window.addEventListener("resize", () => (aboveSm = recompute()));
    persistentItemContainer.addEventListener("click", () => {
      if (aboveSm) {
        return;
      }
      setExpandedItemsContainerVisibility(true);
    });
  });
</script>
