---
import { getImage } from "astro:assets";
import type { I18nResource } from "../strings/types";
import type Post from "../post";
import formatDate from "../utils/dateformat";
import { shapeByName } from "../shapes/by-name";
import CoveredPostCard from "./CoveredPostCard.astro";

import * as updatePost from "../db/update-posts";

interface Props {
  i18n: I18nResource;
  posts?: Post[];
}
const {
  i18n,
  posts = await Promise.all(
    (
      await updatePost.list({
        acceptedLocales: [i18n.localeName ?? "en"],
        ignoreTrash: true,
      })
    ).map(async ({ created, header, title, summary, cover, mask }) => ({
      created: created.getTime(),
      header,
      title,
      summary,
      cover: cover ?? undefined,
      mask: shapeByName[mask],
    })),
  ),
} = Astro.props;
---

<div class="flex flex-row flex-wrap gap-4 px-2 sm:px-6">
  {
    (
      await Promise.all(
        posts.map(async ({ mask, ...others }) => ({
          ...others,
          mask: `url(${(await getImage({ src: mask })).src})`,
        })),
      )
    ).map(({ created, cover, mask, header, title, summary }) => (
      <CoveredPostCard cover={cover} mask={mask} class="flex-1">
        <Fragment slot="header-leading" set:text={header} />
        <Fragment
          slot="header-tailing"
          set:text={formatDate(created, i18n.localeName, "short")}
        />
        <Fragment slot="title" set:text={title} />
        <Fragment slot="summary" set:text={summary} />
      </CoveredPostCard>
    ))
  }
</div>
