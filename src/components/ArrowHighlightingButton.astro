---
import ArrowRight from "../icons/ArrowRight.svg";
import HighlightingButton from "./HighlightingButton.astro";
interface Props {
  href?: string;
}
const { href } = Astro.props;
---

<HighlightingButton href={href}>
  <ArrowRight slot="icon" stroke-width="2.5" />
  <slot />
</HighlightingButton>
