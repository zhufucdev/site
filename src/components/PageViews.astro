---
import { and, eq, sql } from "drizzle-orm";
import db from "../db/connection";
import { pageViewsTable } from "../db/schema/page-views";
import ViewCounter from "./ViewCounter.astro";
import type { SupportedLocale } from "../strings/types";
export interface Props {
  pageId: string;
  class?: string;
  locale?: SupportedLocale;
}
const { pageId, class: clazz, locale } = Astro.props;

let views = 0;
let visitorId: string | undefined = Astro.cookies.get("fingerprint")?.value;
if (typeof visitorId == "undefined") {
  views = await getViews();
  return;
}

async function visitExpired() {
  const pageViews = await Astro.session?.get("pageViews");
  const expired =
    pageViews?.filter(
      ({ timestamp }) =>
        Date.now() - timestamp.getTime() >= 1000 * 60 * 60 * 24, // one day
    ) ?? [];
  if (expired.length <= 0) {
    return false;
  }
  Astro.session?.set(
    "pageViews",
    pageViews!.filter((item) => !expired.includes(item)),
  );
  return true;
}

async function notVisited() {
  return (
    (await Astro.session?.get("pageViews"))?.find(
      (item) => pageId === item.pageId,
    ) === undefined
  );
}

async function getViews() {
  const [page] = await db
    .select({ views: pageViewsTable.views })
    .from(pageViewsTable)
    .where(eq(pageViewsTable.pageId, pageId));
  return page?.views ?? 0;
}

if ((await visitExpired()) || (await notVisited())) {
  const [page] = await db
    .insert(pageViewsTable)
    .values({ pageId, views: 1 })
    .onConflictDoUpdate({
      target: pageViewsTable.pageId,
      set: { views: sql`${pageViewsTable.views} + 1` },
    })
    .returning({ views: pageViewsTable.views });
  views = page.views;
  const pageViews = (await Astro.session?.get("pageViews")) ?? [];
  if (!pageViews.find((item) => item.pageId === pageId)) {
    pageViews.push({
      pageId,
      timestamp: new Date(),
      ip: Astro.clientAddress,
    });
    Astro.session?.set("pageViews", pageViews);
  }
} else {
  views = await getViews();
}
---

<ViewCounter count={views} class={clazz} locale={locale} />
