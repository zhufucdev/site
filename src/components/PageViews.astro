---
import ViewCounter from "./ViewCounter.astro";
import { getViews } from "../utils/page-views";
import type { SupportedLocale } from "../strings/types";

export interface Props {
  pageId: string;
  class?: string;
  locale?: SupportedLocale;
}
const { pageId, class: clazz, locale } = Astro.props;
const { env } = Astro.locals.runtime;

const views = await getViews(
  pageId,
  Astro.session,
  env.SESSION,
  Astro.clientAddress,
);
---

<ViewCounter count={views} class={clazz} locale={locale} />
