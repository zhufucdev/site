---
import ViewCounter from "./ViewCounter.astro";
import { getViews } from "../utils/page-views";
import type { SupportedLocale } from "../strings/types";
import { env } from "cloudflare:workers";

export interface Props {
  pageId: string;
  class?: string;
  locale?: SupportedLocale;
}
const { pageId, class: clazz, locale } = Astro.props;

const views = await getViews(pageId, Astro.session, env, Astro.clientAddress);
---

<page-views data-page-id={pageId}>
  <ViewCounter count={views} class={clazz} locale={locale} />
</page-views>

<script>
  import { actions } from "astro:actions";

  class PageViews extends HTMLElement {
    connectedCallback() {
      window.addEventListener("challenge-resolved", async () => {
        const pageId = this.dataset.pageId;
        if (!pageId) return;
        await actions.incrementPageView({ pageId });
      });
    }
  }

  customElements.define("page-views", PageViews);
</script>
