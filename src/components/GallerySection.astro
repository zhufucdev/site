---
import { getRelativeLocaleUrl } from "astro:i18n";
import { list } from "../db/gallery-items";
import type { SupportedLocale } from "../strings/types";
import Unimage from "./Unimage.astro";
import { defaultLocale } from "../locale";

interface Props {
  targetLocale?: SupportedLocale;
}

const { targetLocale } = Astro.props;
const items = await list({
  targetLocale,
  ignoreTrashed: true,
});
---

<div
  class="flex flex-row flex-wrap items-start gap-2 overflow-clip rounded-2xl"
>
  {
    items.map(({ image, alt, id }) => (
      <a
        href={getRelativeLocaleUrl(
          targetLocale ?? defaultLocale,
          `gallery/${id}`,
        )}
        class="h-60 min-w-40 flex-1 bg-orange-100 sm:min-w-[30%] md:max-w-[33%] md:min-w-[20%]"
        transition:name={`gallery-${id}`}
      >
        <Unimage
          image={image}
          width={400}
          height={240}
          class="size-full object-cover"
          loading="lazy"
          decoding="async"
          sizes="(max-width: 640px) 100vw, 33vw"
          alt={alt}
        />
      </a>
    ))
  }
</div>
