---
import ProgressCircle from "../images/ProgressCircle.svg";
import enRes from "../strings/en";
import type { I18nResource } from "../strings/types";
interface Props {
  i18n?: I18nResource;
  class?: string;
}

const { i18n = enRes, class: clazz } = Astro.props;
---

<comment-section class:list={["relative", clazz]}>
  <div
    class="giscus-loading absolute top-1/2 left-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center gap-1"
  >
    <ProgressCircle
      class:list={[
        "size-12 animate-spin",
        Math.random() < 0.05 ? "animate-spin-lgbt" : "animate-spin",
      ]}
    />

    <p>{i18n.loading_comments}</p>
  </div>
</comment-section>

<style is:global>
  comment-section .giscus ~ .giscus-loading {
    display: none;
  }
</style>

<script>
  class CommentSection extends HTMLElement {
    connectedCallback() {
      const script = document.createElement("script");
      Object.entries({
        src: "https://giscus.app/client.js",
        "data-repo": "zhufucdev/site",
        "data-repo-id": "R_kgDOQvd6Dg",
        "data-category": "Announcements",
        "data-category-id": "DIC_kwDOQvd6Ds4C244a",
        "data-mapping": "pathname",
        "data-strict": "1",
        "data-reactions-enabled": "1",
        "data-emit-metadata": "0",
        "data-input-position": "top",
        "data-theme": "preferred_color_scheme",
        "data-lang": "en",
        "data-loading": "lazy",
        crossorigin: "anonymous",
        async: true,
      }).forEach(([key, value]) => {
        if (typeof value === "string") {
          script.setAttribute(key, value);
        } else if (value) {
          script.setAttribute(key, "");
        }
      });
      this.prepend(script);
    }
  }
  customElements.define("comment-section", CommentSection);
</script>
