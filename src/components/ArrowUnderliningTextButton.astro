---
import UnderliningTextButton from "./UnderliningTextButton.astro";
import ArrowRightCircle from "../icons/ArrowRightCircle.svg";
interface Props {
  selected?: boolean;
}
const { selected = false } = Astro.props;
---

<UnderliningTextButton selected={selected}>
  <ArrowRightCircle slot="icon" />
  <slot />
</UnderliningTextButton>
